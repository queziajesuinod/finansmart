# ─── Servidor ───────────────────────────────────────────────
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:4173
# Nº de proxies reversos confiáveis à frente da API (1 = um nginx). Usado pelo
# rate limit para identificar o IP real do cliente. 0 desliga o trust proxy.
TRUST_PROXY=1

# ─── Banco de dados (PostgreSQL) ────────────────────────────
# Opção A: URL única (tem prioridade se preenchida)
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Opção B: campos separados
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=finansmart
# Opcional: usar um schema específico (cria se não existir)
# DB_SCHEMA=dev
# Em produção com DATABASE_URL: exija certificado TLS válido do Postgres.
# Deixe vazio/false só se o banco usar certificado autoassinado.
# DB_SSL_REJECT_UNAUTHORIZED=true

# ─── Cobrança ───────────────────────────────────────────────
# false = modo teste: todos os usuários ficam liberados com todos os módulos.
# true  = valem as assinaturas (Fase 2 / Stripe).
BILLING_ENABLED=false

# ─── Autenticação ───────────────────────────────────────────
# OBRIGATÓRIO em produção (o servidor não sobe sem ele). Gere algo forte, ex:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_EXPIRES_IN=7d
# Vida do access token (fica só na memória do front; renovado pelo refresh cookie).
ACCESS_TOKEN_TTL=15m

# ─── Sessão longa (refresh token + cookies) ─────────────────
# Janela deslizante da sessão (cookie httpOnly rotativo). O usuário quase nunca
# vê a tela de login: a cada uso o refresh é rotacionado e a validade desliza.
REFRESH_TOKEN_TTL_DAYS=75
# Cookies com secure=true exigem HTTPS. Em produção = true. Em dev (http) = false.
# Vazio: segue NODE_ENV (secure só em production).
# COOKIE_SECURE=false

# ─── Passkeys / WebAuthn (login com Face ID / digital) ──────
# RP_ID = domínio registrável do site; ORIGIN = origem exata (scheme+host+porta),
# aceita lista separada por vírgula. ATENÇÃO: passkeys NÃO funcionam em IP cru
# (127.0.0.1). Em dev, acesse o front por http://localhost:4173 (abaixo).
# Em produção: WEBAUTHN_RP_ID=seu-dominio.com.br / WEBAUTHN_ORIGIN=https://seu-dominio.com.br
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4173
WEBAUTHN_RP_NAME=José Planeja

# Google OAuth (deixe vazio para desativar o login com Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3333/auth/google/callback

# ─── Stripe (usado na Fase 2) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
